APP_NAME=Video Social Bot
APP_BASE_URL=https://your-domain.example
SECRET_KEY=replace-with-random-long-secret
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=replace-with-telegram-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

DATABASE_URL=sqlite+aiosqlite:////app/data/app.db
STORAGE_DIR=/app/storage
MAX_UPLOAD_MB=100
FILE_TTL_HOURS=24
WEB_WORKER_ENABLED=false
COMPOSE_PROJECT_NAME=video-social-bot

OPENAI_API_KEY=replace-with-openai-api-key
WHISPER_MODEL=whisper-1

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=openai/gpt-4o-mini
LLM_HTTP_REFERER=
LLM_APP_TITLE=Video Social Bot

FFMPEG_PRESET=veryfast
OUTPUT_CRF=28
OUTPUT_AUDIO_BITRATE=96k
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
AUDIO_NORMALIZE=true
WATERMARK_TEXT=
WATERMARK_FONT_SIZE=42
WATERMARK_OPACITY=0.35
WATERMARK_POSITION=bottom-right
SUBTITLES_ENABLED=true
BURN_SUBTITLES=false
SUBTITLE_MAX_CHARS=42
SUBTITLE_FONT_SIZE=44

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload
YOUTUBE_TOKEN_PATH=/app/data/youtube-token.json
YOUTUBE_DEFAULT_PRIVACY_STATUS=private
YOUTUBE_PUBLISH_RETRY_LIMIT=3
YOUTUBE_PUBLISH_RETRY_DELAY_SECONDS=300

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=video.upload
TIKTOK_TOKEN_PATH=/app/data/tiktok-token.json
